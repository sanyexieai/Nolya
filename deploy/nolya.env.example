# Install as /etc/nolya/nolya.env (owner root, mode 0600).
# Replace example.com with the verified HTTPS hostname. No passwords belong here.
NOLYA_ENV=production
NOLYA_BIND=127.0.0.1:3000
NOLYA_DB_PATH=/var/lib/nolya/nolya.sqlite
NOLYA_STATIC_DIR=/opt/nolya/current/frontend/dist
NOLYA_PUBLIC_ORIGIN=https://example.com
NOLYA_ALLOWED_ORIGINS=https://example.com
NOLYA_COOKIE_SECURE=true
RUST_LOG=nolya_api=info,tower_http=warn
