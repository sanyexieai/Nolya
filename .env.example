# Run from the project root. Local development defaults only.
NOLYA_ENV=development
NOLYA_SESSION_DAYS=30
NOLYA_BIND=127.0.0.1:3000
NOLYA_DB_PATH=data/nolya.sqlite
NOLYA_STATIC_DIR=frontend/dist
NOLYA_PUBLIC_ORIGIN=http://127.0.0.1:3000
NOLYA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
NOLYA_COOKIE_SECURE=false
RUST_LOG=info
